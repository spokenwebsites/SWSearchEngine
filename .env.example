# Copy this file to .env and fill in values before running docker compose
# Never commit .env — it is gitignored

DB_USER=swrails
DB_PASSWORD=changeme
DB_NAME=swrails_production

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=replacewithoutput_of_rails_secret

# Solr URL — defaults to internal Docker service (http://solr:8983/solr/swallow2)
# Override for production if Solr is on a separate server with auth:
# SOLR_URL=https://username:password@your-solr-host:8983/solr/swallow2
